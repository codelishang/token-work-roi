{
  "name": "token-work",
  "version": "2.0.0",
  "description": "Token Work ROI: A local-first token usage, output evidence, and model strategy review for AI coding.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codelishang/token-work-roi.git"
  },
  "bugs": {
    "url": "https://github.com/codelishang/token-work-roi/issues"
  },
  "homepage": "https://github.com/codelishang/token-work-roi#readme",
  "bin": {
    "token-work": "bin/token-work.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "bin",
    "src",
    "dist-runtime",
    "config",
    "public/manifest.webmanifest",
    "public/token-work-icon.png",
    "public/token-work-icon.svg",
    "public/yuanheng-logo.svg",
    "data/.gitkeep",
    "data/official-pricing.json",
    "docs/demo-data/token-work-demo.json",
    "!docs/demo-data/README.md",
    "index.html",
    "tsconfig.json",
    "vite.config.ts",
    "README.md",
    "README.en.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "NOTICE.md",
    "PRIVACY.md",
    "Dockerfile",
    "docker-compose.yml",
    "render.yaml"
  ],
  "scripts": {
    "start": "node src/cli.ts start",
    "demo": "node src/cli.ts demo",
    "collect": "node src/collect.ts",
    "doctor": "node src/cli.ts doctor",
    "privacy:check": "node src/cli.ts privacy-check",
    "closure:check": "node src/closure-check.ts",
    "closure:import": "node src/closure-import.ts",
    "pricing:update": "node src/update-pricing.ts",
    "dev": "node src/dev.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "node src/server.ts",
    "build": "vite build",
    "preview": "npm run build && node src/server.ts",
    "serve": "node src/server.ts",
    "smoke:npx": "node scripts/smoke-npx.ts",
    "smoke:browser": "node scripts/smoke-browser-console.ts",
    "smoke:published": "node scripts/smoke-published.ts",
    "desktop": "node scripts/run-desktop.ts",
    "desktop:install": "node scripts/install-electron.ts",
    "desktop:smoke": "node scripts/smoke-desktop.ts",
    "prepack": "node scripts/build-runtime.ts",
    "postpack": "node scripts/clean-runtime.ts",
    "typecheck:tools": "tsc --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "electron": "^42.4.1",
    "typescript": "^6.0.3"
  }
}
